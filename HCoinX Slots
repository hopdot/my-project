    function validateBitcoinAddress(address) {
      const btcRegex = /^[13][a-km-zA-HJ-NP-Z1-9]{25,34}$/;
      return btcRegex.test(address);
    }

    async function fetchSlotMachineData() {
      try {
        const response = await fetch("https://example.com/api/slots", {
          headers: {
