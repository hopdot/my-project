        const data = await response.json();
        return data.symbols || defaultSymbols;
      } catch (e) {
        console.warn("API fetch failed, using default symbols.");
        return defaultSymbols;
      }
    }

    document.getElementById("btc-address").addEventListener("input", (e) => {
