<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hcoinx Drive - The Ultimate Racing Game</title>
    <link rel="stylesheet" href="styles.css">
    <style>
        body {
            font-family: Arial, sans-serif;
            background: linear-gradient(to right, #141e30, #243b55);
            color: white;
            text-align: center;
            margin: 0;
            padding: 0;
        }
        header {
            background: rgba(0, 0, 0, 0.8);
            padding: 20px;
        }
        .download-section {
            margin: 20px;
            padding: 20px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
        }
        .download-btn {
            display: inline-block;
            padding: 15px 30px;
            margin: 10px;
            color: white;
            text-decoration: none;
            font-size: 18px;
            font-weight: bold;
            border-radius: 5px;
            transition: background 0.3s;
        }
        .google-play {
            background: #34a853;
        }
        .app-store {
            background: #000;
        }
        .google-play:hover {
            background: #2e8b43;
        }
        .app-store:hover {
            background: #333;
        }
        .features {
            background: rgba(255, 255, 255, 0.2);
            padding: 20px;
            margin: 20px;
            border-radius: 10px;
        }
        ul {
            list-style: none;
            padding: 0;
        }
        ul li {
            font-size: 20px;
            margin: 10px 0;
        }
        footer {
            background: rgba(0, 0, 0, 0.8);
            padding: 10px;
            position: relative;
            bottom: 0;
            width: 100%;
        }
    </style>
</head>
<body>
    <header>
        <h1>Welcome to Hcoinx Drive</h1>
        <p>Experience high-speed racing with custom cars, 44 thrilling stages, and in-game purchases powered by Google Wallet.</p>
    </header>
    
    <section class="download-section">
        <h2>Download Now</h2>
        <a href="#" class="download-btn google-play">Download for Android</a>
        <a href="#" class="download-btn app-store">Download for iOS</a>
    </section>
    
    <section class="features">
        <h2>Game Features</h2>
        <ul>
            <li>⚡ 6 Unique Drivers</li>
            <li>🏁 44 Racing Stages</li>
            <li>🚗 Car Customization</li>
            <li>💳 Google Wallet Integration</li>
            <li>🔥 Stunning 3D Graphics</li>
            <li>🎮 Immersive Gameplay</li>
        </ul>
    </section>
    
    <footer>
        <p>&copy; 2024 Hcoinx. All Rights Reserved.</p>
    </footer>
</body>
</html>
